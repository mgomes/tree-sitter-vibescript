{
  "name": "tree-sitter-vibescript",
  "version": "0.70.0",
  "description": "Tree-sitter grammar for Vibescript",
  "main": "bindings/node",
  "keywords": [
    "tree-sitter",
    "parser",
    "vibescript"
  ],
  "author": "Mauricio Gomes",
  "license": "MIT",
  "dependencies": {
    "nan": "^2.18.0"
  },
  "devDependencies": {
    "tree-sitter-cli": "0.26.13"
  },
  "tree-sitter": [
    {
      "scope": "source.vibescript",
      "file-types": [
        "vibe"
      ],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm"
    }
  ],
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mgomes/tree-sitter-vibescript.git"
  }
}
