{
  "grammars": [
    {
      "name": "vibescript",
      "camelCase": false,
      "scope": "source.vibescript",
      "path": ".",
      "file-types": [
        "vibe"
      ],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm"
    }
  ],
  "metadata": {
    "version": "0.70.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for Vibescript",
    "authors": [
      {
        "name": "Mauricio Gomes"
      }
    ],
    "links": {
      "repository": "https://github.com/mgomes/tree-sitter-vibescript"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
