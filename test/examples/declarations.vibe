# Vibescript 0.80.0 declarations.
enum Status
  Draft
  Published
end

type Entry = { id: string, status: Status, note?: string, ... }
type Pair = [string, int]

module Billing
  type Amount = int
  TAX: int = 8

  def self.with_tax(cents: Amount) -> int
    cents + cents * TAX // 100
  end
end

class Post
  getter title: string
  property status: Status
  @views: int = 0
  @@count: int = 0

  def initialize(@title: string, status: Status = :draft)
    @status = status
    @@count += 1
  end

  def self.count -> int
    @@count
  end

  def view -> int
    @views += 1
    @views
  end
end

def connect(host: string, *, port: int = 8080) -> string
  "https://#{host}:#{port}"
end

def tally(*values: array<int>, **options: hash<string, int>) -> int
  values.sum + options.values.sum
end

def keep(items: array<int>, &block: int -> bool) -> array<int>
  kept: array<int> = []
  items.each { |item|
    kept << item if yield(item)
  }
  kept
end

def read_label(&block: () -> string) -> string
  yield
end

def each_pair(counts: hash<string, int>, &block: (string, int))
  counts.keys.each { |key| yield key, counts.fetch(key) }
end

post = Post.new("Hello")
post.view
post.status = :published
puts post.title
puts Billing.with_tax(100)
puts connect("example.com", port: 443)
puts tally(1, 2, bonus: 3)
puts keep([1, 2, 3]) { |n| n.even? }
puts read_label { "ready" }
each_pair({ a: 1 }) { |key, value| puts "#{key}=#{value}" }
