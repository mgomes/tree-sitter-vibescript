# Vibescript 0.80.0 expressions.
name = "Ada"
greeting = "hello #{name}"
raw = 'no #{interpolation}'
names: array<string> = []
label: string? = nil
amount: int | float = 1
amount = 2.5
pairs: array<[string, int]> = [["a", 1], ["b", 2]]
counts: hash<string, int> = pairs.to_h
counts["c"] = 3

ratio = 7 / 2
quotient = 7 // 2
quotient //= 2
pattern = /id-([0-9]+)/i
matched = "ID-12".match(pattern)
if matched != nil
  puts matched.fetch(1)
end

schema = { id: string, note?: string, ... }
record = JSON.parse_as('{"id":"a"}', schema)
puts record["id"]
data = JSON.parse("[1,2]")
values = data.as(array<int>)
values.each { |value: int| puts value }

summary = if values.length > 1
  "many"
else
  "one"
end
kind = case summary
when "many" then 2
else 1
end

while quotient < 3
  quotient += 1
end
for key, value in counts
  puts "#{key}=#{value}"
end
first, second = [1, 2]
puts first + second

safe = begin
  JSON.parse_as("broken", int)
rescue RuntimeError => error
  puts error.message
  0
ensure
  puts "checked"
end
